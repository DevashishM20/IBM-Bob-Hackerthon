# ─────────────────────────────────────────────────────────────────────────────
# CodeGuardian — Environment Variables
# Copy this file to .env and fill in your real values.
# The .env file must sit in the workspace root (same directory as this file).
# ─────────────────────────────────────────────────────────────────────────────

# IBM Bob API key (required for AI analysis)
# Obtain from: https://bob.ibm.com → your subscription instance → API keys
# Use an "Inference"-scoped key (no extra headers needed).
BOB_API_KEY=bob_prod_bob-apikey_4GC4EUu3zxp2q1zBdaVPCQf2x2yNNBRP27AhivmQu8zsHyLMeNtfLzQCDuTAAFxVm1tJJGK6jseJEzBjeP1qJqSu_4MML6yKn2XrtNkRfiXBzv3b2R5QWyxR7W5xaTvSL37o8

# IBM Bob API base URL (required)
# Replace with the real inference endpoint for your subscription instance.
# The backend appends /chat/completions to this value, so it should end with
# the version segment, e.g.:  https://<instance>.bob.ibm.com/v1
BOB_API_URL=https://api.us-east.bob.ibm.com/inference/v1

# Backend server settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Temp directory for cloned repos / extracted ZIPs
TEMP_DIR=./tmp
