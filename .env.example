# ─────────────────────────────────────────────────────────────────────────────
# CodeGuardian — Environment Variables
# Copy this file to .env and fill in your real values.
# The .env file must sit in the workspace root (same directory as this file).
# ─────────────────────────────────────────────────────────────────────────────

# Backend server settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Temp directory for cloned repos / extracted ZIPs
TEMP_DIR=./tmp
